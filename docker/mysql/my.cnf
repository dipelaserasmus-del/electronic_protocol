[mysqld]
# utf8mb4 stores every Unicode character (utf8/utf8mb3 cannot store emoji and some symbols).
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# The general query log is off: it records every query (incl. data) and slows the server.
# Enable temporarily for debugging with: SET GLOBAL general_log = 1;
general_log = 0
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1

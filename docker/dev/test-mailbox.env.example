# L03: a TEMPORARY test mailbox for the local real-data copy (./dev.sh real up, http://localhost:8081).
# Copied to local-data/test-mailbox.env on the first `./dev.sh real up`; that copy is git-ignored and
# never leaves your computer. Fill it in, run `./dev.sh real up` again, then pick
# «Δοκιμαστικός λογαριασμός» in Ρυθμίσεις → E-mail → Λογαριασμός εισερχομένων.
#
# Use only a mailbox made for testing: registering an e-mail in the app moves it out of the inbox,
# the same as with the real account. Leave TEST_IMAP_HOST empty to switch the test account off.
#
# Examples: Gmail imap.gmail.com 993 ssl (with an "app password"), Outlook outlook.office365.com 993 ssl,
# sch.gr mail.sch.gr 993 ssl.
TEST_IMAP_HOST=
TEST_IMAP_PORT=993
# ssl (port 993, recommended) or starttls (port 143). Not "tls" on 143: here tls means TLS from the start, as ssl.
TEST_IMAP_ENCRYPTION=ssl
TEST_IMAP_VALIDATE_CERT=true
TEST_IMAP_USERNAME=
TEST_IMAP_PASSWORD=

# Outgoing mail (optional). Empty TEST_SMTP_HOST = everything the copy sends stays in Mailpit
# (http://localhost:8026). Port 465 = SSL, 587 = STARTTLS. Empty username/password = the IMAP ones above.
# sch.gr: mail.sch.gr 465 (or 587).
TEST_SMTP_HOST=
TEST_SMTP_PORT=465
TEST_SMTP_USERNAME=
TEST_SMTP_PASSWORD=
# Sender address (empty = the SMTP username)
TEST_SMTP_FROM=
# SAFETY: e-mails reach ONLY these addresses (comma-separated; empty = the sender address above, i.e. the
# test mailbox itself). Anyone else (the real staff and senders in your copy) is taken off; the message then
# goes to the first address here, with «[ΔΟΚΙΜΗ] προς: <original recipients>» in its subject.
TEST_MAIL_ONLY_TO=

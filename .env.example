# Template for a normal installation. Copy to .env and fill in; .env is never committed.
# Generate APP_KEY with:  php artisan key:generate   (Docker: docker compose exec app php artisan key:generate)
APP_NAME="Ηλ. Πρωτόκολλο"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# outgoing mail (receipts, assignment notices)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=protocol@example.org
MAIL_FROM_NAME="Ηλ. Πρωτόκολλο"
MAIL_TIMEOUT=10

# incoming mail to register (IMAP)
IMAP_HOST=imap.example.org
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_DEFAULT_ACCOUNT=default
IMAP_PROTOCOL=imap

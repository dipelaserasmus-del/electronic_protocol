# Local development / preview stack (./dev.sh). Copied to .env.development on first run.
APP_NAME="Ηλ. Πρωτόκολλο (DEV)"
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=astrongpass

CACHE_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# All outgoing mail goes to Mailpit (http://localhost:8025), never to real recipients
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=protocol@school.test
MAIL_FROM_NAME="Ηλ. Πρωτόκολλο (DEV)"

# Mock IMAP server (GreenMail) preloaded with test emails
IMAP_HOST=imap
IMAP_PORT=3143
IMAP_ENCRYPTION=false
IMAP_VALIDATE_CERT=false
IMAP_USERNAME=protocol@school.test
IMAP_PASSWORD=secret
IMAP_DEFAULT_ACCOUNT=default
IMAP_PROTOCOL=imap
